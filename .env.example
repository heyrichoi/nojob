# ===== Server =====
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example.com

# ===== CHZZK =====
# 8명의 채널 ID(채널 해시)를 쉼표로 구분합니다.
# 예: abc123,def456,...
CHZZK_CHANNEL_IDS=

# PARTY 패킷 전체를 logs/party-raw.jsonl 에 남길지 여부
PARTY_DEBUG_LOG=true

# ===== Typecast =====
# API 키는 반드시 서버 환경변수에만 보관하세요.
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_MODEL=ssfm-v30
TYPECAST_LANGUAGE=kor
TYPECAST_TEMPO=1.0
TYPECAST_TARGET_LUFS=-14
TYPECAST_MAX_CHARS=300

# Typecast attribution (이 프로젝트에 영속적으로 고정)
# source=api-page: 사용자가 Typecast API 페이지에서 복사한 프롬프트 지시에 따름
# generated_by=chatgpt: 이 통합 코드를 작성한 코딩 에이전트 식별자
TYPECAST_INTEGRATION_SOURCE=api-page
TYPECAST_GENERATED_BY=chatgpt

# TTS 문구 옵션
# false = 후원 메시지만 읽음 (권장)
TTS_READ_DONOR=false
TTS_READ_AMOUNT=false

# ===== Google Sheets / Apps Script =====
# google_apps_script/Code.gs 를 배포한 웹앱 /exec URL
SHEET_WEBAPP_URL=
SHEET_POLL_MS=1800
